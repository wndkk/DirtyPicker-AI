<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_robot_arm">
    <xacro:arg name="use_fake_hardware" default="false"/>

    <link name="base_link">
        <visual>
            <geometry>
                <mesh filename="package://robot_arm/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <material name="black">
                <color rgba="0.1 0.1 0.1 1"/>
            </material>
            
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://robot_arm/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </collision>
    </link>
    
    <link name="bottom_frame">
        <visual>
            <geometry>
                <mesh filename="package://robot_arm/meshes/bottom_frame.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 1.57"/>
            <material name="black">
                <color rgba="0.1 0.1 0.1 1"/>
            </material>
            
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://robot_arm/meshes/bottom_frame.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 1.57"/>
        </collision>
    </link>
    <link name="link1">
        <visual>
            <geometry>
                <mesh filename="package://robot_arm/meshes/arm.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 1.57 1.57"/>
            <material name="white">
                <color rgba="1 1 1 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://robot_arm/meshes/arm.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 1.57 1.57"/>
        </collision>
    </link>
    <link name="link2">
        <visual>
            <geometry>
                <mesh filename="package://robot_arm/meshes/arm.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 1.57 1.57"/>
            <material name="white">
                <color rgba="1 1 1 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://robot_arm/meshes/arm.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 1.57 1.57"/>
        </collision>
    </link>
    <link name="end_effector">
        <visual>
            <geometry>
                <mesh filename="package://robot_arm/meshes/end_effector.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 1.57 1.57"/>
            <material name="red">
                <color rgba="1 0 0 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://robot_arm/meshes/end_effector.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 1.57 1.57"/>
        </collision>
    </link>
    <link name="gripper_base_link">
        <visual>
            <geometry>
                <mesh filename="package://robot_arm/meshes/hand_base.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 1.57 1.57"/>
            <material name="white">
                <color rgba="1 1 1 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://robot_arm/meshes/hand_base.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 1.57 1.57"/>
        </collision>
    </link>
    
    <link name="finger_left_frame">
        <visual>
            <geometry>
                <mesh filename="package://robot_arm/meshes/finger_left_frame.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 1.57 1.57"/>
            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://robot_arm/meshes/finger_left_frame.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 1.57 1.57"/>
        </collision>
    </link>
    <link name="finger_left_link">
            <visual>
                <geometry>
                    <mesh filename="package://robot_arm/meshes/finger_right.stl" scale="0.001 0.001 0.001"/>
                </geometry>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 -1.57 -1.57"/>
                <material name="black">
                    <color rgba="0 0 0 1"/>
                </material>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://robot_arm/meshes/finger_right.stl" scale="0.001 0.001 0.001"/>
                </geometry>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 -1.57 -1.57"/>
            </collision>
    </link>
    <link name="finger_right_frame">
        <visual>
            <geometry>
                <mesh filename="package://robot_arm/meshes/finger_right_frame.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 1.57 1.57"/>
            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://robot_arm/meshes/finger_right_frame.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 1.57 1.57"/>
        </collision>
    </link>
    <link name="finger_right_link">
        <visual>
            <geometry>
                <mesh filename="package://robot_arm/meshes/finger_right.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 1.57 1.57"/>
            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://robot_arm/meshes/finger_right.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 1.57 1.57"/>
        </collision>
    </link>
    <joint name="joint0" type="revolute">
        <parent link="base_link"/>
        <child link="bottom_frame"/>
        <origin xyz="0.0 0.0 0.0468" rpy="0.0 0.0 0.0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.57" upper="1.57" effort="1.0" velocity="1.0"/>
    </joint>
    <joint name="joint1" type="revolute">
        <parent link="bottom_frame"/>
        <child link="link1"/>
        <origin xyz="0.0 0.0 0.0347" rpy="0.0 0.0 0.0"/>
        <axis xyz="-1 0 0"/>
        <limit lower="-2.1012" upper="0.0" effort="1.0" velocity="1.0"/>
    </joint>
    <joint name="joint2" type="revolute">
        <parent link="link1"/>
        <child link="link2"/>
        <origin xyz="0.0 0.15 0.0" rpy="0.0 0.0 0.0"/>
        <axis xyz="-1 0 0"/>
        <limit lower="-1.5708" upper="1.5708" effort="1.0" velocity="1.0"/>
    </joint>
    <joint name="joint3" type="revolute">
        <parent link="link2"/>
        <child link="end_effector"/>
        <origin xyz="0.0 0.15 0.0" rpy="0.0 0.0 0.0"/>
        <axis xyz="-1 0 0"/>
        <limit lower="-1.5708" upper="1.5708" effort="1.0" velocity="1.0"/>
    </joint>
    <joint name="gripper_joint" type="fixed">
        <parent link="end_effector"/>
        <child link="gripper_base_link"/>
        <origin xyz="0.0 0.03 0.0" rpy="0.0 0.0 0.0"/>
    </joint>
    <joint name="gripper_left_joint" type="revolute">
        <parent link="gripper_base_link"/>
        <child link="finger_left_frame"/>
        <origin xyz="0.012 0.024 0.0" rpy="0.0 0.0 0.0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.57" upper="0.0" effort="1.0" velocity="1.0"/>
    </joint>
    <joint name="gripper_left_hand" type="revolute">
        <parent link="finger_left_frame"/>
        <child link="finger_left_link"/>
        <origin xyz="-0.009 0.03 0.0" rpy="0.0 0.0 0.0"/>
        <axis xyz="0 0 1"/>
        <mimic joint="gripper_left_joint" multiplier="-1" offset="0"/>
        <limit lower="0.0" upper="1.57" effort="1.0" velocity="1.0"/>
    </joint>
    <joint name="gripper_right_joint" type="revolute">
        <parent link="gripper_base_link"/>
        <child link="finger_right_frame"/>
        <origin xyz="-0.012 0.024 0.0" rpy="0.0 0.0 0.0"/>
        <axis xyz="0 0 1"/>
        <mimic joint="gripper_left_joint" multiplier="-1" offset="0"/>
        <limit lower="0.0" upper="1.57" effort="1.0" velocity="1.0"/>
    </joint>
    <joint name="gripper_right_hand" type="revolute">
        <parent link="finger_right_frame"/>
        <child link="finger_right_link"/>
        <origin xyz="0.009 0.03 0.0" rpy="0.0 0.0 0.0"/>
        <axis xyz="0 0 1"/>
        <mimic joint="gripper_right_joint" multiplier="-1" offset="0"/>
        <limit lower="-1.57" upper="0.0" effort="1.0" velocity="1.0"/>
    </joint>

    
  <ros2_control name="DynamixelSystem" type="system">
    <hardware>
        <xacro:if value="$(arg use_fake_hardware)">
            <plugin>mock_components/GenericSystem</plugin>
        </xacro:if>

        <xacro:unless value="$(arg use_fake_hardware)">
            <plugin>dynamixel_hardware_interface/DynamixelHardware</plugin>
            <param name="port_name">/dev/ttyUSB0</param>
            <param name="baud_rate">1000000</param>
            <param name="use_dummy">false</param>
            <param name="protocol_version">1.0</param>
            
            <param name="dynamixel_model_folder">/param/dxl_model</param>

            <param name="error_timeout_ms">5000</param>
            
            <param name="number_of_joints">5</param>
            <param name="number_of_transmissions">5</param>

            <param name="disable_torque_at_init">true</param>
        </xacro:unless>
    </hardware>

    <joint name="joint0">
      <param name="id">0</param>
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint1">
      <param name="id">1</param>
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint2">
      <param name="id">2</param>
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint3">
      <param name="id">3</param>
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="gripper_left_joint">
      <param name="id">4</param>
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    
    <gpio name="dxl_joint0">
      <param name="type">dxl</param>
      <param name="ID">0</param>
      <command_interface name="Goal Position"/>
      <state_interface name="Present Position"/>
      <state_interface name="Present Velocity"/>
      <param name="Return Delay Time">0</param>
    </gpio>

    <gpio name="dxl_joint1">
      <param name="type">dxl</param>
      <param name="ID">1</param>
      <command_interface name="Goal Position"/>
      <state_interface name="Present Position"/>
      <state_interface name="Present Velocity"/>
      <param name="Return Delay Time">0</param>
    </gpio>

    <gpio name="dxl_joint2">
      <param name="type">dxl</param>
      <param name="ID">2</param>
      <command_interface name="Goal Position"/>
      <state_interface name="Present Position"/>
      <state_interface name="Present Velocity"/>
      <param name="Return Delay Time">0</param>
    </gpio>

    <gpio name="dxl_joint3">
      <param name="type">dxl</param>
      <param name="ID">3</param>
      <command_interface name="Goal Position"/>
      <state_interface name="Present Position"/>
      <state_interface name="Present Velocity"/>
      <param name="Return Delay Time">0</param>
    </gpio>

    <gpio name="dxl_joint4">
      <param name="type">dxl</param>
      <param name="ID">4</param>
      <command_interface name="Goal Position"/>
      <state_interface name="Present Position"/>
      <state_interface name="Present Velocity"/>
      <param name="Return Delay Time">0</param>
    </gpio>
    </ros2_control>

</robot>